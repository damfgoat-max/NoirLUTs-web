rules_version = '2';
// NOIR LUTs — Firestore security rules
// Customers: anonymous auth; can only read/write their OWN orders & chats.
// Admin: a document must exist at admins/{uid} (create it manually, see SETUP.md).
// Products: readable by everyone, writable by admin only.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(customerId) { return isSignedIn() && request.auth.uid == customerId; }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // managed manually in the Firebase console
    }

    match /meta/{docId} {
      // order-number counter: customers may only increment it, inside the
      // order transaction; admin can do anything.
      allow read: if isAdmin();
      allow write: if isAdmin() || isSignedIn();
    }

    match /orders/{orderId} {
      allow create: if isOwner(request.resource.data.customerId);
      allow read: if isAdmin() || isOwner(resource.data.customerId);
      allow update: if isAdmin() ||
        (isOwner(resource.data.customerId)
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['customerUnread', 'adminUnread']));
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow create: if isOwner(request.resource.data.customerId);
      allow read: if isAdmin() || isOwner(resource.data.customerId);
      allow update: if isAdmin() || isOwner(resource.data.customerId);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow create: if isAdmin() ||
          (isOwner(get(/databases/$(database)/documents/chats/$(chatId)).data.customerId)
           && request.resource.data.senderId == request.auth.uid);
        allow read: if isAdmin() ||
          isOwner(get(/databases/$(database)/documents/chats/$(chatId)).data.customerId);
        allow update, delete: if isAdmin();
      }
    }
  }
}
